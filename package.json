{
  "name": "seminole-water-godmode-v13-probabilistic",
  "version": "14.0.0",
  "private": true,
  "scripts": {
    "start": "node platform.js",
    "start:core": "node server.js",
    "test": "node --test tests.js",
    "sync": "python3 scripts/sync_fdep.py",
    "sync:service-areas": "python3 scripts/sync_service_areas.py",
    "audit:agents": "python3 scripts/run_metal_agents.py",
    "test:golden": "node scripts/run_golden_cases.js",
    "canary": "node scripts/run_canaries.js",
    "sync:sdwis": "python3 scripts/sync_sdwis_violations.py",
    "test:mutation-e2e": "node scripts/run_e2e_mutations.js",
    "test:research": "node --test tests.js",
    "test:probabilistic": "node --test tests.js",
    "test:integration": "node --test tests/integration.test.js",
    "audit:crosswalk": "node tools/audit_crosswalk.js",
    "test:all": "node --test tests.js tests/integration.test.js tests/address_evidence.test.js tests/epa_data.test.js tests/negotiation_accuracy.test.js tests/causal_conformal.test.js tests/simple_frontend.test.js tests/local_data.test.js tests/hardening.test.js tests/community.test.js && python3 -m unittest tests.test_sync_epa",
    "test:address": "node --test tests/address_evidence.test.js",
    "test:community": "node --test tests/community.test.js",
    "sync:epa": "python3 scripts/sync_epa_seminole.py --bulk-sdwis",
    "sync:epa:sdwis": "python3 scripts/sync_epa_seminole.py --source sdwis --bulk-sdwis",
    "sync:epa:sdwis:bulk": "python3 scripts/sync_epa_seminole.py --source sdwis --bulk-sdwis",
    "sync:epa:wqp": "python3 scripts/sync_epa_seminole.py --source wqp",
    "sync:epa:ccr": "python3 scripts/sync_epa_seminole.py --source ccr",
    "test:epa": "node --test tests/epa_data.test.js",
    "sync:epa:sdwis:fast": "python3 scripts/sync_epa_seminole.py --source sdwis",
    "test:sync-script": "python3 -m unittest tests.test_sync_epa",
    "test:negotiation": "node --test tests/negotiation_accuracy.test.js",
    "calibrate:agents": "node scripts/calibrate_agent_reliability.js",
    "test:causal-conformal": "node --test tests/causal_conformal.test.js",
    "sync:pfas": "python3 scripts/sync_pfas.py",
    "sync:private-wells": "python3 scripts/sync_private_wells.py",
    "sync:telemetry": "python3 scripts/sync_telemetry.py",
    "sync:local": "npm run sync:pfas && npm run sync:private-wells && npm run sync:telemetry",
    "sync:all": "npm run sync:epa && npm run sync:local",
    "test:local": "node --test tests/local_data.test.js",
    "prune:investigations": "node -e \"const{pruneInvestigations,retentionPolicy}=require('./lib/runtime_hardening');console.log(pruneInvestigations(process.cwd(),{days:retentionPolicy().days}))\"",
    "verify:ccr": "node scripts/verify_against_ccr.js",
    "loadtest": "node scripts/loadtest.js",
    "sync:epa:force": "SDWA_FORCE_DOWNLOAD=1 python3 scripts/sync_epa_seminole.py --bulk-sdwis",
    "mail:weekly": "node scripts/send_digest.js weekly",
    "mail:monthly": "node scripts/send_digest.js monthly"
  },
  "dependencies": {
    "google-auth-library": "^10.3.0",
    "nodemailer": "^7.0.5",
    "pg": "^8.16.3"
  }
}
